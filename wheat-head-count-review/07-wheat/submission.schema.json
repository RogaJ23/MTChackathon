{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wheat-head count audit version 0.3.0 submission",
  "type": "object",
  "required": [
    "packet_version",
    "route",
    "model",
    "provenance",
    "rows"
  ],
  "properties": {
    "packet_version": {
      "const": "0.5.0-internal"
    },
    "route": {
      "const": "07-wheat"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "training",
        "external_models",
        "hyperparameters",
        "pre_event_work"
      ],
      "properties": {
        "training": {
          "type": "string"
        },
        "external_models": {
          "type": "array"
        },
        "hyperparameters": {
          "type": "object"
        },
        "pre_event_work": {
          "type": "string"
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1381,
      "maxItems": 1381,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prediction",
          "lower",
          "upper",
          "review",
          "status",
          "correction",
          "correction_image_sha256",
          "review_priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prediction": {
            "type": "number",
            "minimum": 0
          },
          "lower": {
            "type": "number",
            "minimum": 0
          },
          "upper": {
            "type": "number",
            "minimum": 0
          },
          "review": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "correction": {
            "type": [
              "number",
              "null"
            ]
          },
          "correction_image_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_priority": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
